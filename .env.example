# PostgreSQL local (khớp với docker-compose.yml)
DATABASE_URL=postgresql://lingoflow:lingoflow_dev@localhost:5432/lingoflow
DATABASE_SSL=false

# Web server
PORT=4173
NODE_ENV=development

# Tài khoản demo mặc định (UUID cố định cho bản không đăng nhập)
DEMO_USER_ID=11111111-1111-4111-8111-111111111111

# AI thật: chỉ đặt key ở server, tuyệt đối không đưa vào frontend.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
